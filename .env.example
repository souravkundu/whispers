# ── Whisper environment variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets.

# ── Database ─────────────────────────────────────────────────────────────────

# Option A — explicit SQLAlchemy URL (takes precedence over CHAT_DB)
# DATABASE_URL=postgresql+psycopg://whisper:CHANGE_ME@postgres:5432/whisper

# Option B — legacy SQLite path
# CHAT_DB=/data/chat.db

# Option C — default: <project_root>/chat.db (no variable needed)

# ── Redis ─────────────────────────────────────────────────────────────────────
# Omit or leave blank to run in single-instance mode (no distributed features).
# REDIS_URL=redis://localhost:6379/0

# If true, startup fails when Redis is unreachable.
# REDIS_REQUIRED=false

# ── Admin ─────────────────────────────────────────────────────────────────────
# Required to access /api/admin/* endpoints.
# Use a strong random value in production.
# ADMIN_TOKEN=CHANGE_ME_use_a_strong_random_value

# ── Application ───────────────────────────────────────────────────────────────
# ENVIRONMENT=development
# SQL_ECHO=false
# PORT=8000
